# ─────────────────────────────────────────────────────────────────────────────
# TaskMaster API — Variables de Entorno
# Copia este archivo a db_config/.env y ajusta los valores
# ─────────────────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=django-insecure-taskmaster-dev-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Motor de Base de Datos ───────────────────────────────────────────────────
# Opciones: 'postgresql' (producción) o 'sqlite' (desarrollo local rápido)
DB_ENGINE=sqlite

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=taskmaster_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── JWT (segundos) ──────────────────────────────────────────────────────────
# Access token: 30 minutos
ACCESS_TOKEN_LIFETIME=1800
# Refresh token: 7 días
REFRESH_TOKEN_LIFETIME=604800

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
