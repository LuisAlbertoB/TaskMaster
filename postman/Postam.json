						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/tareas/1/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tareas", "1", ""]
						}
					},
					"response": []
				},
				{
					"name": "Editar Tarea (PUT - 403 Forbidden si no es propia)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"titulo\": \"Módulo de Autenticación Actualizado\",\n  \"descripcion\": \"Actualizado vía PUT\",\n  \"estado\": true,\n  \"prioridad\": 2,\n  \"tag_ids\": [1, 2]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/tareas/1/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tareas", "1", ""]
						}
					},
					"response": []
				},
				{
					"name": "Eliminar Tarea (DELETE - Borra Imagen Huérfana)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/tareas/1/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tareas", "1", ""]
						},
						"description": "Elimina la tarea. Si tenía una imagen asociada, elimina el registro y los archivos del disco."
					},
					"response": []
				}
			]
		}
