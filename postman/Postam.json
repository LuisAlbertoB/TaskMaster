							"path": ["api", "imagenes", ""]
						}
					},
					"response": []
				},
				{
					"name": "Subir Imagen (Valida JPG/PNG/WEBP <= 2MB)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "imagen",
									"type": "file",
									"description": "Selecciona una imagen (JPG, PNG, WEBP <= 2MB)"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/imagenes/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "imagenes", ""]
						},
						"description": "Subida multipart de imagen. Genera miniatura automática con Pillow."
					},
					"response": []
				},
				{
					"name": "Ver Detalle de Imagen",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/imagenes/1/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "imagenes", "1", ""]
						}
					},
					"response": []
				},
				{
					"name": "Eliminar Imagen (Limpia Archivos de Disco)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/imagenes/1/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "imagenes", "1", ""]
						}
					},
					"response": []
				}
			]
		},
