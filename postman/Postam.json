		{
			"name": "05. Tareas (/api/tareas/)",
			"item": [
				{
					"name": "Listar Tareas (Privacidad por Usuario)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/tareas/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tareas", ""]
						},
						"description": "Retorna solo las tareas creadas por el usuario autenticado (usuarios root ven todas)."
					},
					"response": []
				},
				{
					"name": "Listar Tareas con Filtros (?estado= & ?prioridad= & ?tag=)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/tareas/?estado=false&prioridad=3&tag=1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tareas", ""],
							"query": [
								{
									"key": "estado",
									"value": "false"
								},
								{
									"key": "prioridad",
									"value": "3"
								},
								{
									"key": "tag",
									"value": "1"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Crear Tarea Vía JSON (Auto-Asigna Propietario)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"titulo\": \"Módulo de Autenticación\",\n  \"descripcion\": \"Implementar JWT con DRF\",\n  \"prioridad\": 3,\n  \"imagen_id\": 1,\n  \"tag_ids\": [1, 3]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/tareas/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tareas", ""]
						},
						"description": "Crea una tarea asociando imagen_id previa y tag_ids M:N. Asigna automáticamente el usuario del JWT."
					},
					"response": []
				},
				{
					"name": "Crear Tarea Subiendo Imagen Directa (1 solo request)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "titulo",
									"value": "Diseñar interfaz gráfica",
									"type": "text"
								},
								{
									"key": "descripcion",
									"value": "Maquetado en React",
									"type": "text"
								},
								{
									"key": "prioridad",
									"value": "2",
									"type": "text"
								},
								{
									"key": "imagen_file",
									"type": "file",
									"description": "Selecciona imagen (JPG/PNG/WEBP <= 2MB)"
								},
								{
									"key": "tag_ids",
									"value": "1",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/tareas/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tareas", ""]
						},
						"description": "Crea la tarea y sube/procesa la imagen directa en un solo request multipart/form-data."
					},
					"response": []
				},
				{
					"name": "Ver Detalle de Tarea",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
